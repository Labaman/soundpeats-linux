[Unit]
Description=BLE Service for Soundpeats Earbuds
After=network.target

[Service]
ExecStart=/usr/local/bin/soundpeats
Restart=on-failure
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# The earbuds are auto-detected and connected on startup. Optionally pin a
# specific device (if several QCY/SoundPeats are around) with its control
# address (see the Detect/Scan methods):
# Environment=SOUNDPEATS_DEVICE=AA:BB:CC:DD:EE:FF
# On connect the device is shown in Bluetooth UIs as "SoundPeats BLE control";
# override the name, or leave empty to disable, with:
# Environment=SOUNDPEATS_ALIAS=My Earbuds

[Install]
WantedBy=default.target
