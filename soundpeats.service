[Unit]
Description=BLE Service for Soundpeats Earbuds
After=network.target

[Service]
ExecStart=/usr/local/bin/soundpeats
Restart=on-failure
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# Set your earbuds' MAC address to auto-connect on startup (find it with `bluetoothctl devices`).
# Environment=SOUNDPEATS_DEVICE=AA:BB:CC:DD:EE:FF

[Install]
WantedBy=default.target
